#!/usr/bin/env bash
#
# sync — deterministically resync external
# repos into patches/ subdirectories. Replaces `git subtree pull`.
#
# Each dependency is fully mirrored from a fresh shallow clone via rsync,
# so there is no merge step and nothing to partially apply or conflict.
# The upstream commit synced is recorded in a `.sync-info` file,
# since squash commits alone are easy to lose
# track of across repeated resyncs.
#
# Usage:
#   ./sync              # sync everything
#   ./sync susfs4ksu    # sync just one entry by name
#
set -euo pipefail

# name|local prefix|remote url|ref (branch/tag)
DEPS=(
  "kernel_patches|patches/kernel_patches|git@github.com:poqdavid/kernel_patches.git|dev"
  "susfs4ksu|patches/susfs4ksu|https://gitlab.com/simonpunk/susfs4ksu.git|gki-android12-5.10"
)

FILTER="${1:-}"
SIGN_COMMITS="${SIGN_COMMITS:-1}"

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# gpg needs a TTY to prompt for a passphrase when run non-interactively
# (cron, wrapper scripts, etc); without this, signing fails with
# "Inappropriate ioctl for device".
if [ -z "${GPG_TTY:-}" ]; then
    export GPG_TTY="$(tty 2>/dev/null || true)"
fi

TMPROOT="$(mktemp -d)"
trap 'rm -rf "$TMPROOT"' EXIT

sync_one() {
    local name="$1" prefix="$2" url="$3" ref="$4"
    local clone_dir="$TMPROOT/$name"
    local manifest="$prefix/.sync-info"

    echo "==> $name ($ref)"

    local prev_sha=""
    if [ -f "$manifest" ]; then
        prev_sha="$(grep '^commit=' "$manifest" | cut -d= -f2)"
    fi

    # No --depth here (just --single-branch to limit data to the one ref):
    # we need real history to build a changelog of what actually changed
    # since the last sync, not just the tip commit.
    git clone --quiet --single-branch --branch "$ref" "$url" "$clone_dir"
    local upstream_sha
    upstream_sha="$(git -C "$clone_dir" rev-parse HEAD)"

    if [ -n "$prev_sha" ] && [ "$prev_sha" = "$upstream_sha" ]; then
        echo "    already at $upstream_sha, skipping"
        return 0
    fi

    mkdir -p "$prefix"
    # --checksum compares actual content instead of the default
    # size+mtime quick check. Needed because $clone_dir is a fresh
    # checkout every run, so its mtimes are always "just now" and would
    # never quick-match $prefix's existing mtimes -- without this, every
    # file gets rewritten (and its mtime bumped) on every run regardless
    # of whether its content actually changed.
    rsync -a --delete --checksum --exclude='.git' "$clone_dir/" "$prefix/"

    {
        echo "source=$url"
        echo "ref=$ref"
        echo "commit=$upstream_sha"
        echo "synced=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } > "$manifest"

    git add -A -- "$prefix"
    if git diff --cached --quiet -- "$prefix"; then
        echo "    no file changes despite new upstream commit, skipping commit"
        return 0
    fi

    local body
    if [ -n "$prev_sha" ] && git -C "$clone_dir" cat-file -e "${prev_sha}^{commit}" 2>/dev/null; then
        local commit_count
        commit_count="$(git -C "$clone_dir" rev-list --count "$prev_sha..$upstream_sha")"
        body="$(git -C "$clone_dir" log --reverse --pretty='format:- %s (%h)' "$prev_sha..$upstream_sha" | head -n 50)"
        if [ "$commit_count" -gt 50 ]; then
            body="$body
... and $((commit_count - 50)) more commits"
        fi
    elif [ -n "$prev_sha" ]; then
        body="(previous commit $prev_sha not found in upstream history -- rebased or force-pushed; showing latest commit only)
$(git -C "$clone_dir" log -1 --pretty='format:- %s (%h)')"
    else
        body="$(git -C "$clone_dir" log -1 --pretty='format:- %s (%h)')"
    fi

    local msg="sync: $name to ${upstream_sha:0:12}

$body"

    local commit_args=(--quiet -m "$msg")
    if [ "$SIGN_COMMITS" = "1" ]; then
        if [ -n "${SIGNING_KEY:-}" ]; then
            commit_args=(-S"${SIGNING_KEY}" "${commit_args[@]}")
        else
            commit_args=(-S "${commit_args[@]}")
        fi
    fi
    git commit "${commit_args[@]}"

    local sig
    sig="$(git log -1 --pretty=%G?)"
    echo "    synced -> ${upstream_sha:0:12} (commit $(git rev-parse --short HEAD), sig: $sig)"
}

for dep in "${DEPS[@]}"; do
    IFS='|' read -r name prefix url ref <<< "$dep"
    if [ -n "$FILTER" ] && [ "$FILTER" != "$name" ]; then
        continue
    fi
    sync_one "$name" "$prefix" "$url" "$ref"
done
